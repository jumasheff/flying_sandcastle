# Flying Sandcastle settings. On the server: /etc/factory/factory.env
# Read by bash: quote values that contain spaces.
# Not secret. Secrets go in /etc/factory/secrets.env and host-secrets.env.

# The project the factory works on: owner/name on GitHub.
TARGET_REPO=jumasheff/turna
BASE_BRANCH=main

# Labels. They match the triage labels of mattpocock/skills
# (see docs/agents/triage-labels.md in the project).
# Put READY_LABEL on an issue to hand it to the factory.
READY_LABEL=ready-for-agent
# Issues written by the issue-intake skill. The factory ignores them until you
# replace this label with READY_LABEL.
IDEA_LABEL=needs-triage
REVIEW_LABEL=sandcastle:in-review
HUMAN_LABEL=sandcastle:needs-human

# Claude Code model aliases (or full model IDs).
PLANNER_MODEL=opus
IMPLEMENTER_MODEL=sonnet
REVIEWER_MODEL=sonnet

# Issues worked on at the same time. 2 fits a 4 vCPU / 8 GB server.
MAX_PARALLEL=2
# Agent iterations per issue before it gives up.
IMPLEMENTER_MAX_ITERATIONS=30

# Commit author for agent commits.
GIT_AUTHOR_NAME="Sandcastle Bot"
GIT_AUTHOR_EMAIL=sandcastle-bot@users.noreply.github.com

# --- Staging (docs/staging.md) ------------------------------------------------
# Every run deploys BASE_BRANCH to this Fly app when it has changed.
# Leave STAGING_APP empty to turn staging deploys off.
STAGING_APP=turna-staging
# The staging Supabase project (public values, like in fly.toml).
STAGING_SUPABASE_URL=https://YOUR-STAGING-REF.supabase.co
STAGING_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
