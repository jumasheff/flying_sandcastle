# On the server: /etc/factory/host-secrets.env  (chmod 600, owner factory)
# Used only by scripts/deploy-staging.sh on the host. Never passed to agents.

# Deploy token for the staging app ONLY (it cannot touch production):
#   fly tokens create deploy -a turna-staging
FLY_API_TOKEN=

# Staging Supabase database, for applying migrations. Supabase dashboard of the
# STAGING project -> Connect -> Session pooler -> URI (with the DB password).
# Quote it.
STAGING_DB_URL=""
