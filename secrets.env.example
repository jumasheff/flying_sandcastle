# On the server: /etc/factory/secrets.env  (chmod 600, owner factory)
# Only the keys written here are passed into the agent sandboxes.

# Claude Max subscription. On a computer with Claude Code logged in, run:
#   claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# Fine-grained GitHub token, ONLY for the project repo. Permissions:
#   Contents: Read and write, Pull requests: Read and write,
#   Issues: Read and write, Metadata: Read
GH_TOKEN=
