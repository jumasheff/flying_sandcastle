# On the server: /etc/factory/secrets.env  (chmod 600, owner factory)
# EVERY key in this file is passed into the agent sandboxes.
# Host-only secrets (Fly, database) go in host-secrets.env instead.

# Claude Max subscription. Get it with:  npx -y @anthropic-ai/claude-code setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# Fine-grained GitHub token, ONLY for the project repo. Permissions:
#   Contents: Read and write, Pull requests: Read and write,
#   Issues: Read and write, Metadata: Read
GH_TOKEN=
